
<!DOCTYPE html>
<html>
<head>
    <title>Tourism Website</title>
    <style>
        body {
            font-family: Arial;
            margin: 0;
            background-color: #f2f2f2;
        }

        /* Navigation */
        nav {
            background-color: darkblue;
            padding: 15px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        /* Header */
        header {
            background-color: skyblue;
            color: white;
            text-align: center;
            padding: 30px;
        }

        /* Sections */
        section {
            padding: 20px;
            text-align: center;
        }

        /* Destination Cards */
        .places {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background-color: white;
            width: 250px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 0 5px gray;
        }

        .card img {
            width: 100%;
            height: 150px;
        }

        /* Gallery */
        .gallery img {
            width: 200px;
            height: 130px;
            margin: 10px;
        }

        footer {
            background-color: darkblue;
            color: white;
            text-align: center;
            padding: 15px;
        }

        button {
            background-color: orange;
            color: white;
            padding: 10px;
            border: none;
            cursor: pointer;
        }

        /* Mobile Design */
        @media(max-width: 600px) {
            .card {
                width: 90%;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation -->
    <nav>
        <a href="#home">Home</a>
        <a href="#places">Places</a>
        <a href="#festivals">Festivals</a>
        <a href="#food">Food</a>
        <a href="#gallery">Gallery</a>
    </nav>

    <!-- Header -->
    <header id="home">
        <h1>Explore India Tourism</h1>
        <p>Discover Beautiful Places and Indian Culture</p>
    </header>

    <!-- Tourist Places -->
    <section id="places">
        <h2>Famous Tourist Places</h2>

        <div class="places">

            <div class="card">
                <img src="https://placehold.co/250x150?text=Taj+Mahal"
                     alt="Taj Mahal">
                <h3>Taj Mahal</h3>
                <p>Agra, Uttar Pradesh</p>
                <p>Famous historical monument.</p>
            </div>

            <div class="card">
                <img src="https://placehold.co/250x150?text=Charminar"
                     alt="Charminar">
                <h3>Charminar</h3>
                <p>Hyderabad, Telangana</p>
                <p>Famous historical monument.</p>
            </div>

            <div class="card">
                <img src="https://placehold.co/250x150?text=Goa"
                     alt="Goa">
                <h3>Goa</h3>
                <p>Goa, India</p>
                <p>Popular beach destination.</p>
            </div>

        </div>
    </section>

    <!-- Regions -->
    <section>
        <h2>Tourism by Region</h2>
        <p>North India - Taj Mahal, Jaipur</p>
        <p>South India - Charminar, Hampi</p>
        <p>West India - Goa, Mumbai</p>
    </section>

    <!-- Festivals -->
    <section id="festivals">
        <h2>Cultural Festivals</h2>
        <p>Diwali - Festival of Lights</p>
        <p>Holi - Festival of Colours</p>
        <p>Onam - Kerala Festival</p>
        <p>Pongal - Tamil Nadu Festival</p>
    </section>

    <!-- Local Food -->
    <section id="food">
        <h2>Famous Indian Food</h2>
        <p>Hyderabadi Biryani - Telangana</p>
        <p>Dosa and Idli - South India</p>
        <p>Vada Pav - Maharashtra</p>
        <p>Dal Baati - Rajasthan</p>
    </section>

    <!-- Image Gallery -->
    <section id="gallery">
        <h2>Tourism Image Gallery</h2>

        <div class="gallery">
            <img src="https://placehold.co/200x130?text=Monuments"
                 alt="Monuments">
            <img src="https://placehold.co/200x130?text=Beaches"
                 alt="Beaches">
            <img src="https://placehold.co/200x130?text=Festivals"
                 alt="Festivals">
        </div>
    </section>

    <!-- Travel Tips -->
    <section>
        <h2>Travel Tips</h2>
        <p>1. Carry your identity card.</p>
        <p>2. Book tickets in advance.</p>
        <p>3. Carry drinking water.</p>
        <p>4. Keep your belongings safe.</p>
        <p>5. Respect local culture.</p>
    </section>

    <!-- Footer -->
    <footer>
        <h3>Explore India Tourism</h3>
        <p>Email: tourism@gmail.com</p>
        <p>© 2026 Tourism Website</p>
    </footer>
</body>
</html>
