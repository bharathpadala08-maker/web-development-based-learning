
<!DOCTYPE html>
<html>
<head>
    <title>My Profile</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f2f5f9;
            scroll-behavior: smooth;
        }

        header {
            background: #243b55;
            color: white;
            text-align: center;
            padding: 25px;
            animation: fadeIn 2s;
        }

        nav {
            background: #141e30;
            padding: 15px;
            text-align: center;
            position: sticky;
            top: 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 10px;
            display: inline-block;
        }

        nav a:hover {
            color: orange;
            transform: scale(1.1);
        }

        section {
            background: white;
            margin: 20px;
            padding: 20px;
            border-radius: 10px;
            animation: slideUp 1s;
        }

        h2 {
            color: #243b55;
        }

        .skills span {
            display: inline-block;
            background: #243b55;
            color: white;
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
        }

        a.button {
            background: #243b55;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }

        footer {
            background: #141e30;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            nav a {
                margin: 5px;
                font-size: 14px;
            }

            section {
                margin: 10px;
            }
        }
    </style>
</head>

